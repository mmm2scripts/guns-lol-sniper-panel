# Copy to .env (same folder as server.py) and edit. Real environment variables override this file.

# Where to listen. Keep 127.0.0.1 when a reverse proxy (Caddy/nginx) provides HTTPS.
HOST=127.0.0.1
PORT=8787

# Optional: set your own API key (24+ chars). If unset, a random key is generated on first start
# and printed once (only its hash is stored in data/api_key.sha256).
# PANEL_API_KEY=

# Behind a reverse proxy, trust X-Forwarded-For for the login-throttle IP:
# TRUST_PROXY=1

# Direct HTTPS without a reverse proxy (certificate + key files):
# TLS_CERT=/etc/letsencrypt/live/sniper.example.com/fullchain.pem
# TLS_KEY=/etc/letsencrypt/live/sniper.example.com/privkey.pem

# Restrict browser origins (the iOS app sends Origin: null). Default "*" is fine: auth is a bearer token.
# CORS_ORIGIN=*

# Resume the sniper automatically if the server restarts while it was running (default 1).
# AUTO_RESUME=1

# Optional: ScrapingAnt key from the environment instead of config.json (67.py already supports this).
# SCRAPINGANT_KEY=
